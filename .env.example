# Copy to .env and adjust. Never commit .env.

# Where recordings, transcripts, models and the database live on the host (Docker)
TLS_HOST_DATA_DIR=./data
TLS_PORT=8420

# Parallel jobs
TLS_DOWNLOAD_CONCURRENCY=2
TLS_TRANSCRIBE_CONCURRENCY=1

# Transcribe automatically after each download (also switchable in the GUI)
TLS_AUTO_TRANSCRIBE=false

# Record HLS streams of lectures whose lecturer disabled downloads (also switchable in the GUI).
# Personal study only - keep the recordings to yourself.
TLS_STREAM_CAPTURE=false

# Default model (fw-large-v3-turbo | fw-large-v3 | fw-medium | fw-small | mlx-large-v3-turbo | remote)
# Leave empty to use the hardware-based recommendation.
TLS_STT_MODEL=

# Host-native STT companion, e.g. MLX on a Mac while the app runs in Docker:
# TLS_STT_REMOTE_URL=http://host.docker.internal:8421

# Extra hostnames allowed in the Host header (comma-separated). Only needed behind a reverse proxy.
# TLS_ALLOWED_HOSTS=

# Development only: Discord webhook for progress notifications (scripts/notify_discord.py)
DISCORD_WEBHOOK_URL=<PASTE_WEBHOOK_URL_HERE>
